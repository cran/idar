Package: idar
Version: 1.6
Date: 2025-05-01
Title: Individual Diversity-Area Relationships
Authors@R: person(given = "Marcelino",
                        family = "de la Cruz",
                        role = c("aut", "cre"),
                        email = "marcelino.delacruz@urjc.es",
